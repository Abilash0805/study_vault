rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Chapter Kit — Firestore security rules
//
//  Deploy:  Firebase Console → Firestore Database → Rules → paste
//           → Publish.  (Or `firebase deploy --only firestore:rules`)
//
//  If you change ADMIN_EMAIL in assets/js/config.js you MUST change
//  it here too — the client constant grants nothing on its own.
//
//  WHY CONTENT IS SPLIT ACROSS TWO COLLECTIONS
//  Firestore rules cannot filter a collection query: a rule that
//  depends on per-document data makes the whole query fail rather
//  than returning the allowed subset. So the browsable catalogue
//  and the paid bytes have to live apart:
//
//    materials/{id}        metadata only — any signed-in user may
//                          read it, so the library and (later) the
//                          store can list what exists.
//    materialContent/{id}  the actual bytes — readable only by
//                          someone who has that id in their files[].
//                          Fetched one document at a time.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmail() {
      return "abi.abilashv0805@gmail.com";
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Student docs are keyed by lowercased email; tokens may not be.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && callerEmail() == adminEmail();
    }

    function studentDoc() {
      return get(/databases/$(database)/documents/students/$(callerEmail()));
    }

    // True when the caller has been granted this material id.
    // `.get('files', [])` keeps a student doc with no files[] from erroring.
    function hasAccess(materialId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(callerEmail()))
        && materialId in studentDoc().data.get('files', []);
    }

    // ── STUDENTS ────────────────────────────────────────────
    // Admin manages everyone. A student may read only their own doc
    // (to discover what they've been granted) and may never write it,
    // so nobody can grant themselves access.
    match /students/{email} {
      allow read, write: if isAdmin();
      allow read: if signedIn() && callerEmail() == email;
    }

    // ── MATERIAL METADATA ───────────────────────────────────
    // Title, tag, folder, price. Safe to list: it carries no content.
    // Keep it that way — never write content fields back into here.
    match /materials/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── MATERIAL CONTENT ────────────────────────────────────
    // The part worth paying for. Per-document reads only; a student
    // listing the whole collection is denied, by design.
    match /materialContent/{id} {
      allow read:  if isAdmin() || hasAccess(id);
      allow write: if isAdmin();
    }

    // ── MATERIAL SAMPLES ────────────────────────────────────
    // A free preview of a paid material. Readable by anyone signed in
    // on purpose: its whole job is to be seen before buying. Keep real
    // content out of here — this collection is not gated.
    match /materialSample/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── FOLDERS ─────────────────────────────────────────────
    // Names only, so students can see the tree they've been given.
    match /folders/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── PAYMENT SETTINGS ────────────────────────────────────
    // The UPI id students pay to. Readable by anyone signed in
    // because checkout has to display it; only the admin sets it.
    match /settings/{key} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── ORDERS ──────────────────────────────────────────────
    // A student may raise their own order and say "I've paid";
    // only the admin may mark one paid. Note the student CANNOT
    // grant themselves access — students/{email} is admin-write
    // only — so a forged order is inert until the admin confirms
    // the money actually arrived.
    //
    // Reading: a student can only query their own orders, and the
    // query must say so (see listMyOrders) since rules cannot
    // filter a collection query.
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.email == callerEmail());

      allow create: if signedIn()
        && request.resource.data.email == callerEmail()
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.totalPaise is int
        && request.resource.data.totalPaise >= 0
        // approval fields may never be present at creation
        && !request.resource.data.keys().hasAny(
             ['paidAt', 'confirmedBy', 'refundedAt', 'refundedBy']);

      // The student's only moves: attach a payment reference, or
      // walk away. Everything else on the order stays untouched.
      allow update: if signedIn()
        && resource.data.email == callerEmail()
        && (
          (resource.data.status == 'pending_payment'
            && request.resource.data.status == 'awaiting_confirmation'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['utr', 'status', 'submittedAt', 'updatedAt']))
          ||
          (resource.data.status == 'pending_payment'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt']))
        );

      allow update, delete: if isAdmin();
    }

    // ── LEDGER ──────────────────────────────────────────────
    // Append-only. Written by the admin when a payment is
    // confirmed or refunded; never edited or deleted by anyone,
    // so the money trail cannot be quietly rewritten.
    match /ledger/{id} {
      allow read:   if isAdmin() || (signedIn() && resource.data.email == callerEmail());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── MATERIAL REQUESTS ───────────────────────────────────
    // A student asks for a chapter; the admin triages it. Private
    // to author and admin, so nobody can read what other students
    // are stuck on, or who asked for what.
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.email == callerEmail());

      allow create: if signedIn()
        && request.resource.data.email == callerEmail()
        && request.resource.data.status == 'open'
        && request.resource.data.chapter is string
        && request.resource.data.chapter.size() > 0
        && request.resource.data.chapter.size() <= 140
        && request.resource.data.get('subject', '').size() <= 60
        && request.resource.data.get('details', '').size() <= 1000
        // the admin's side of the conversation can't be pre-filled
        && !request.resource.data.keys().hasAny(['adminNote', 'materialId', 'fulfilledAt']);

      // The student's only write after creating: withdrawing it.
      allow update: if signedIn()
        && resource.data.email == callerEmail()
        && resource.data.status == 'open'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt']);

      allow update, delete: if isAdmin();
    }

    // Anything not matched above is denied. New collections must be
    // added deliberately rather than inheriting access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
